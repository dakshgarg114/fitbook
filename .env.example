# Copy to .env and fill in. Never commit .env. See README.md for where each value comes from.

# --- AI and nutrition ---------------------------------------------------------
# DeepSeek API key (https://platform.deepseek.com/api_keys). Required.
DEEPSEEK_API_KEY=
# USDA FoodData Central key (https://fdc.nal.usda.gov/api-key-signup). DEMO_KEY works for light use.
USDA_API_KEY=DEMO_KEY

# --- Google sign-in (Firebase) ------------------------------------------------
# Your Firebase project ID. The server only accepts sign-in tokens from this project.
FIREBASE_PROJECT_ID=your-firebase-project-id
# Web app config from Firebase console > Project settings > Your apps > Web app.
# These are public by design (they ship in the web bundle); restrict the API key to your domains.
VITE_FIREBASE_API_KEY=your-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-firebase-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_APP_ID=your-web-app-id

# --- Server -------------------------------------------------------------------
# Local development only: skip sign-in and treat every request as this email. Never set in production.
DEV_USER_EMAIL=
# Per-user chat limits.
CHAT_LIMIT_PER_HOUR=60
CHAT_LIMIT_PER_DAY=100
# Optional: server port (default 4310) and SQLite path (default data/fitbook.db).
# PORT=4310
# FITBOOK_DB=
